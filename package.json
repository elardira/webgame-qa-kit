{
  "name": "webgame-qa-kit",
  "version": "0.1.0",
  "description": "Reusable release checks for browser games and stateful web applications.",
  "keywords": [
    "browser-game",
    "playwright",
    "quality-assurance",
    "release-gate",
    "responsive-testing",
    "save-state"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config.js",
    "./browser": "./src/browser-audit.js",
    "./save": "./src/save-integrity.js",
    "./regression": "./src/regression.js",
    "./secrets": "./src/secret-scan.js"
  },
  "bin": {
    "webgame-qa": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "syntax": "node scripts/check-syntax.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "security:worktree": "node src/cli.js secrets . --output .qa-output/secret-scan.json",
    "security:history": "node scripts/history-secret-scan.mjs",
    "security": "npm run security:worktree && npm run security:history",
    "build": "node scripts/build.mjs",
    "example:validate": "node scripts/validate-example.mjs",
    "ci": "npm run lint && npm run typecheck && npm run syntax && npm run test && npm run security && npm run build && npm run example:validate",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2"
  }
}
